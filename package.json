{
  "name": "my-skills",
  "version": "1.2.0",
  "private": true,
  "description": "Operational agent skills from software engineering books and field practice: refactoring, test design, git diff review, and consistent diagram styling with HTML and animated SVG. Install via npx skills. Bilingual docs (EN/zh-CN).",
  "keywords": [
    "agent-skills",
    "skills.sh",
    "claude-code",
    "opencode",
    "codex",
    "hermes-agent",
    "openclaw",
    "refactoring",
    "code-smells",
    "software-testing",
    "test-design",
    "code-review",
    "git-diff",
    "architecture-diagrams",
    "animated-svg",
    "flowcharts",
    "class-diagrams",
    "sequence-diagrams"
  ],
  "license": "MIT",
  "files": [
    "fowler-refactoring/**",
    "myers-art-of-software-testing/**",
    "git-diff-review/**",
    "animated-diagram-style/**",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "list": "npx skills add . -l",
    "install:local": "npx skills add . --all -y",
    "install:global": "npx skills add . --all -g -y",
    "install:opencode": "npx skills add . --all -a opencode -y",
    "install:claude": "npx skills add . --all -a claude-code -y",
    "install:codex": "npx skills add . --all -a codex -y",
    "install:dsh": "npx skills add . --all -g -a codex -y"
  }
}
