{
  "name": "my-skills",
  "version": "1.1.0",
  "private": true,
  "description": "Operational agent skills distilled from classic software engineering books: Fowler Refactoring + Myers Art of Software Testing. Install via npx skills for Claude Code, OpenCode, Codex, Hermes Agent, OpenClaw, and 50+ agents. Bilingual docs (EN/zh-CN).",
  "keywords": [
    "agent-skills",
    "skills.sh",
    "claude-code",
    "opencode",
    "codex",
    "hermes-agent",
    "openclaw",
    "refactoring",
    "code-smells",
    "software-testing",
    "test-design"
  ],
  "license": "MIT",
  "files": [
    "fowler-refactoring/**",
    "myers-art-of-software-testing/**",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "list": "npx skills add . -l",
    "install:local": "npx skills add . --all -y",
    "install:global": "npx skills add . --all -g -y",
    "install:opencode": "npx skills add . --all -a opencode -y",
    "install:claude": "npx skills add . --all -a claude-code -y",
    "install:codex": "npx skills add . --all -a codex -y"
  }
}
